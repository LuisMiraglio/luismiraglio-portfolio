---
const { projects } = Astro.props;
const sortedProjects = [...projects].sort((a, b) => a.data.order - b.data.order);
const [featuredProject, ...secondaryProjects] = sortedProjects;

const processSteps = [
  { number: "01", label: "Entrada manual" },
  { number: "02", label: "Python + Selenium" },
  { number: "03", label: "Interfaz de escritorio" },
  { number: "04", label: "Uso en producción" },
];
---

<section id="proyectos" class="section projects-section" aria-labelledby="projects-title">
  <div class="container">
    <header class="projects-heading">
      <p class="projects-eyebrow">Caso destacado</p>
      <h2 id="projects-title">Proyectos</h2>
      <p class="section-subtitle">
        Ingeniería aplicada a problemas reales, desde el análisis del proceso hasta su uso en producción.
      </p>
    </header>

    {featuredProject && (
      <article class="featured-project">
        <div class="featured-project-visual">
          <img
            src={featuredProject.data.image.src}
            alt={featuredProject.data.image.alt}
            loading="lazy"
            width="1200"
            height="760"
          />
          <div class="visual-caption" aria-hidden="true">
            <span class="visual-status-dot"></span>
            Flujo operativo automatizado
          </div>
        </div>

        <div class="featured-project-content">
          <div class="project-meta">
            <span>{featuredProject.data.category}</span>
            <span class="project-status"><i aria-hidden="true"></i>{featuredProject.data.status}</span>
          </div>

          <h3>{featuredProject.data.title}</h3>
          <p class="project-summary">{featuredProject.data.summary}</p>

          <div class="project-narrative">
            <div>
              <span class="narrative-label">Problema real</span>
              <p>Un flujo operativo repetitivo que dependía de múltiples pasos manuales.</p>
            </div>
            <div>
              <span class="narrative-label">Solución</span>
              <p>Una aplicación de escritorio que centraliza y automatiza la ejecución.</p>
            </div>
          </div>

          <dl class="project-impact">
            <dt>Impacto operativo</dt>
            <dd>{featuredProject.data.impact}</dd>
          </dl>

          <div class="project-supporting-data">
            <div>
              <span class="supporting-label">Stack técnico</span>
              <ul class="project-stack" aria-label={`Stack principal de ${featuredProject.data.title}`}>
                {featuredProject.data.stack.map((tech) => <li>{tech}</li>)}
              </ul>
            </div>
            <div>
              <span class="supporting-label">Rol</span>
              <p>{featuredProject.data.role.join(" · ")}</p>
            </div>
          </div>

          <div class="project-actions">
            <a class="btn primary project-cta" href={`/projects/${featuredProject.slug}/`}>
              Ver caso de estudio <span aria-hidden="true">→</span>
            </a>
            {featuredProject.data.privateRepository && (
              <p class="project-private-note">
                <span aria-hidden="true">◈</span> Código privado por confidencialidad
              </p>
            )}
          </div>
        </div>

        <div class="project-process" aria-labelledby="process-title">
          <div class="process-heading">
            <span id="process-title">Del proceso manual al uso real</span>
            <span aria-hidden="true">Flujo / 04 etapas</span>
          </div>
          <ol>
            {processSteps.map((step) => (
              <li>
                <span class="process-number">{step.number}</span>
                <span>{step.label}</span>
              </li>
            ))}
            <li class="process-result">
              <span class="process-number">Resultado</span>
              <strong>90–100 %</strong>
              <span>menos tiempo operativo aprox.</span>
            </li>
          </ol>
        </div>
      </article>
    )}

    {secondaryProjects.length > 0 && (
      <div class="secondary-projects" aria-label="Más casos de estudio">
        {secondaryProjects.map((project) => (
          <article class="secondary-project">
            <img src={project.data.image.src} alt={project.data.image.alt} loading="lazy" />
            <div>
              <span>{project.data.category}</span>
              <h3>{project.data.title}</h3>
              <p>{project.data.summary}</p>
              <a href={`/projects/${project.slug}/`}>Ver caso de estudio de {project.data.title}</a>
            </div>
          </article>
        ))}
      </div>
    )}
  </div>
</section>
