---
const { projects } = Astro.props;
const sortedProjects = [...projects].sort((a, b) => a.data.order - b.data.order);
---

<section id="proyectos" class="section projects-section" aria-labelledby="projects-title">
  <div class="container">
    <header class="projects-heading">
      <p class="projects-eyebrow">Caso destacado</p>
      <h2 id="projects-title">Proyectos</h2>
    </header>

    <div class="projects-list">
      {sortedProjects.map((project) => (
        <article class="featured-project">
          <div class="featured-project-visual">
            <img
              src={project.data.image.src}
              alt={project.data.image.alt}
              loading="lazy"
              width="1200"
              height="720"
            />
          </div>

          <div class="featured-project-content">
            <div class="project-meta">
              <span>{project.data.category}</span>
              <span class="project-status"><i aria-hidden="true"></i>{project.data.status}</span>
            </div>

            <h3>{project.data.title}</h3>
            <p class="project-summary">{project.data.summary}</p>

            <dl class="project-impact">
              <dt>Impacto</dt>
              <dd>{project.data.impact}</dd>
            </dl>

            <ul class="project-stack" aria-label={`Stack principal de ${project.data.title}`}>
              {project.data.stack.map((tech) => <li>{tech}</li>)}
            </ul>

            <div class="project-actions">
              <a class="btn primary" href={`/projects/${project.slug}/`}>Ver caso de estudio</a>
              {project.data.privateRepository && (
                <p class="project-private-note">Código privado por confidencialidad.</p>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
